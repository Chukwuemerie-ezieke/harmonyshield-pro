# HarmonyShield Pro — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── REQUIRED (Production) ───────────────────────────────
# JWT secret for signing authentication tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ─── OPTIONAL ─────────────────────────────────────────────
# AlienVault OTX API Key — enhances threat intelligence feeds
# Get a free key at: https://otx.alienvault.com
OTX_API_KEY=

# AbuseIPDB API Key — enables live IP reputation checks
# Get a free key at: https://www.abuseipdb.com (1,000 checks/day)
ABUSEIPDB_API_KEY=

# ─── SERVER ───────────────────────────────────────────────
# Port (most hosting platforms set this automatically)
PORT=5000

# Environment: "development" or "production"
NODE_ENV=development

# ─── DATABASE (only if migrating to PostgreSQL) ──────────
# Uncomment and set when switching from SQLite to PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/harmonyshield
