# HarmonyShield Pro — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── REQUIRED (Production) ───────────────────────────────
# JWT secret for signing authentication tokens.
# REQUIRED in production: the server REFUSES to start unless this is set to a
# strong value (at least 32 characters). It never falls back to a default
# secret in production. In development an unset/weak secret is allowed (an
# insecure dev fallback is used) but a loud warning is logged.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed cross-origin origins for CORS.
# Leave empty for same-origin only (the default single-port serving model).
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# ─── OPTIONAL ─────────────────────────────────────────────
# AlienVault OTX API Key — enhances threat intelligence feeds
# Get a free key at: https://otx.alienvault.com
OTX_API_KEY=

# AbuseIPDB API Key — enables live IP reputation checks.
# REQUIRED for the /api/ip-check endpoint: without it the endpoint reports that
# IP reputation is unavailable (503) instead of returning any simulated data.
# Get a free key at: https://www.abuseipdb.com (1,000 checks/day)
ABUSEIPDB_API_KEY=

# ─── OBSERVABILITY / ERROR TRACKING ───────────────────────
# Optional error-tracking hook for unhandled server errors. Both are UNSET by
# default, in which case error tracking is a safe no-op (errors are still
# logged locally). Request logs are structured JSON regardless.
#   ERROR_WEBHOOK: a URL that receives a JSON POST per unhandled error
#                  ({message, stack, context, timestamp}) - no secrets.
#   SENTRY_DSN:    when set, errors are emitted as structured JSON log lines
#                  tagged for a Sentry sidecar / log drain (no SDK bundled).
ERROR_WEBHOOK=
SENTRY_DSN=

# ─── SERVER ───────────────────────────────────────────────
# Port (most hosting platforms set this automatically)
PORT=5000

# Environment: "development" or "production"
NODE_ENV=development

# ─── DATABASE (dual-driver: SQLite by default, PostgreSQL opt-in) ─
# The storage layer selects its driver from DATABASE_URL at startup:
#   - UNSET  -> SQLite via better-sqlite3 (zero-config). A local data.db file is
#              created and seeded automatically on first run. This is the
#              default for development and tests.
#   - SET    -> PostgreSQL via drizzle-orm/node-postgres (pg Pool). Use this in
#              production. Apply the committed migrations in ./migrations before
#              first start (see DEPLOYMENT_GUIDE.md), e.g.:
#                DATABASE_URL=... npm run db:migrate   # apply committed SQL
#                # or, for a quick first provision: npm run db:push
#              The demo data seed still runs automatically on first startup when
#              the schools table is empty.
# DATABASE_URL=postgresql://user:password@host:5432/harmonyshield
