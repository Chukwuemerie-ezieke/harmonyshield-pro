{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "havonashield",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Built SPA + landing page (npm run build → dist/public)
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Postgres via Hyperdrive. Create with:
  //   npx wrangler hyperdrive create havonashield-db --caching-disabled --connection-string="postgres://…"
  // (caching MUST stay disabled: the app needs read-after-write consistency)
  // then paste the returned id below.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      // Used by `wrangler dev` only
      "localConnectionString": "postgres://havona:havona@localhost:5432/havonashield"
    }
  ],

  // Refresh live threat/news feeds every 15 minutes
  "triggers": { "crons": ["*/15 * * * *"] },

  // Workers Rate Limiting (per key, per 60s)
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],

  "routes": [
    { "pattern": "havonashield.tech", "custom_domain": true },
    { "pattern": "www.havonashield.tech", "custom_domain": true },
    { "pattern": "app.havonashield.tech", "custom_domain": true },
    { "pattern": "demo.havonashield.tech", "custom_domain": true }
  ],
  "workers_dev": false,

  "vars": {
    "ENVIRONMENT": "production",
    "MARKETING_HOST": "havonashield.tech",
    "DEMO_HOSTS": "demo.havonashield.tech",
    "APP_URL": "https://app.havonashield.tech",
    "DEMO_URL": "https://demo.havonashield.tech"
  },

  "observability": { "enabled": true },
  "upload_source_maps": true

  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   JWT_SECRET (required, 32+ chars), OTX_API_KEY, ABUSEIPDB_API_KEY
}
